# Copy to .env.local and fill in values (required for `pnpm start` / production mode).

# --- Required for auth (min 32 chars) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Required for app URLs ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Required for database ---
DATABASE_URL=postgresql://user:password@localhost:5432/modelry

# --- Email (sign-up verification, password reset) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Optional OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI (defaults work with local Ollama) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=qwen3.5:0.8b
# Ollama requires this model to be pulled locally. For Gemini Embedding 2, set
# AI_PROVIDER=google and ASSET_EMBEDDING_MODEL=gemini-embedding-2-preview.
ASSET_EMBEDDING_MODEL=nomic-embed-text
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional: Arcjet, Blob, Razorpay, Inngest ---
# ARKJET_API_KEY=
# BLOB_READ_WRITE_TOKEN=
# MAX_UPLOAD_FILE_SIZE_BYTES=10485760
# MAX_UPLOAD_FILES_PER_MESSAGE=5
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
