{
  "name": "modelry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "rimraf .next && next dev",
    "build": "next build",
    "start": "next start",
    "auth:generate": "npx @better-auth/cli generate --config ./src/core/auth/auth.ts --yes",
    "auth:migrate": "npx @better-auth/cli migrate --config ./src/core/auth/auth.ts",
    "db:introspect": "npx drizzle-kit introspect --config ./src/core/db/drizzle.ts",
    "db:generate": "npx drizzle-kit generate --config ./src/core/db/drizzle.ts",
    "db:migrate": "npx drizzle-kit migrate --config ./src/core/db/drizzle.ts",
    "db:push": "npx drizzle-kit push --config ./src/core/db/drizzle.ts",
    "db:studio": "npx drizzle-kit studio --config ./src/core/db/drizzle.ts",
    "db:drop": "npx drizzle-kit drop --config ./src/core/db/drizzle.ts",
    "db:reset": "pnpm db:drop && pnpm db:push",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && pnpm run typecheck",
    "email:dev": "react-email dev",
    "starter:smoke": "node scripts/starter-smoke.test.mjs"
  },
  "dependencies": {
